# ------------------------------------------------------------------
# Manara inquiries API — environment configuration
# Copy this file to `.env` and fill in the values you need.
# Everything here is OPTIONAL: without email/DB config the API still
# records inquiries to a local SQLite file under ./data.
# ------------------------------------------------------------------

# Server
PORT=3001
NODE_ENV=development

# Where inquiry data is stored (relative to the project root).
# The API automatically uses SQLite (node:sqlite) when available and
# falls back to a JSON-lines file otherwise.
DATA_DIR=./data

# Rate limiting — max submissions per IP within the window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=8

# Spam guard — minimum plausible time (ms) to complete the brief.
MIN_FORM_ELAPSED_MS=2500

# Comma-separated list of allowed origins. Leave blank outside
# production to allow any origin (useful for the Vite dev server).
CORS_ORIGIN=

# ------------------------------------------------------------------
# Email delivery (nodemailer). Leave blank to disable.
# When disabled, inquiries are still saved and you can read them from
# the ./data store — the API reports email as "not_configured".
# ------------------------------------------------------------------

# Where project briefs are delivered and where the From address lives.
COMPANY_NAME=Manara
COMPANY_EMAIL=hello@manara.sa
COMPANY_WEBSITE=https://manara.sa
MAIL_FROM="Manara <hello@manara.sa>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------
# Frontend (Vite) — PUBLIC values only, shipped to the browser.
# Only VITE_* variables reach the client, so never place secrets here.
# ------------------------------------------------------------------

# WhatsApp number for the "Begin the Project Brief" button.
# Full international format, e.g. +966560394576. Spaces, dashes and
# a leading "+" are stripped automatically. If left blank the bundled
# ORBIT STUDIO default (+966560394576) is used.
VITE_WHATSAPP_NUMBER=

# Optional custom pre-filled WhatsApp greeting (a sensible default is used if blank).
VITE_WHATSAPP_MESSAGE=

# ------------------------------------------------------------------
# Vercel deployment
#
# The frontend is served as a static build and the Express API runs as a
# Vercel Function (api/[...path].js). Add the following in the Vercel
# dashboard (Project -> Settings -> Environment Variables) or with the CLI
# (`vercel env add <NAME> production`).
#
# Required for production:
#   NODE_ENV=production
#   DATA_DIR=/tmp/manara-data        # writable on Vercel (ephemeral)
#   VITE_WHATSAPP_NUMBER=+966560394576
#
# Secrets (never commit these):
#   SMTP_HOST / SMTP_USER / SMTP_PASS
#
# NOTE: Vercel Functions have an ephemeral filesystem, so the local
# SQLite/JSON store does not persist between invocations. Email delivery
# (SMTP) is the durable record of each inquiry — configure SMTP for
# production. For durable storage, point the API at an external database.
# ------------------------------------------------------------------
